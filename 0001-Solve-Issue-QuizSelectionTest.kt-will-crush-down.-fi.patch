From aec05c632a99748e40b50064aee10e6062fcd506 Mon Sep 17 00:00:00 2001
From: Momo <mynameisjoyg@gmail.com>
Date: Sat, 19 Sep 2026 20:37:36 +0800
Subject: [PATCH] Solve Issue: QuizSelectionTest.kt will crush down. (fixes #3)

---
 .idea/deploymentTargetSelector.xml                            | 4 ++++
 .../androidTest/java/com/joyg/quizhero/QuizSelectionTest.kt   | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/.idea/deploymentTargetSelector.xml b/.idea/deploymentTargetSelector.xml
index 46cbd24..7bd7295 100644
--- a/.idea/deploymentTargetSelector.xml
+++ b/.idea/deploymentTargetSelector.xml
@@ -6,6 +6,10 @@
         <option name="selectionMode" value="DROPDOWN" />
         <DialogSelection />
       </SelectionState>
+      <SelectionState runConfigName="testNavigateToQuizActivity()">
+        <option name="selectionMode" value="DROPDOWN" />
+        <DialogSelection />
+      </SelectionState>
       <SelectionState runConfigName="testSelectSpinnerItemsAndStartQuiz_DoesNotCrash()">
         <option name="selectionMode" value="DROPDOWN" />
         <DialogSelection />
diff --git a/app/src/androidTest/java/com/joyg/quizhero/QuizSelectionTest.kt b/app/src/androidTest/java/com/joyg/quizhero/QuizSelectionTest.kt
index bf5f4fd..c8e6a08 100644
--- a/app/src/androidTest/java/com/joyg/quizhero/QuizSelectionTest.kt
+++ b/app/src/androidTest/java/com/joyg/quizhero/QuizSelectionTest.kt
@@ -87,7 +87,7 @@ class QuizSelectionTest {
         intended(hasComponent(QuizActivity::class.java.name))
 
         // 等待 5 秒
-        //SystemClock.sleep(3000)
+        SystemClock.sleep(3000)
         onView(withId(R.id.tv_question)).check(matches(isDisplayed()))
 
         // 6. 重要：返回 MainActivity，以便進行下一個迴圈測試
-- 
