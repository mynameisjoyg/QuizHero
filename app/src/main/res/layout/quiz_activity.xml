<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="36dp"
    android:paddingBottom="56dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- 顯示接收到的科目 -->
        <TextView
            android:id="@+id/tv_selected_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="載入中..."
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="問題："
                android:textSize="24sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioGroup
                android:id="@+id/rg_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="24sp" />

                <RadioButton
                    android:id="@+id/rb_B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:textSize="24sp" />

                <RadioButton
                    android:id="@+id/rb_C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C"
                    android:textSize="24sp" />

                <RadioButton
                    android:id="@+id/rb_D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:textSize="24sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="提交" />
                <Button
                    android:id="@+id/bt_next_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一題" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 底部搶答選項區 -->
            <LinearLayout
                android:id="@+id/layoutAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionA"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:maxLines="5"
                    android:layout_marginBottom="12dp"
                    android:text="選項 A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/btn_outlined_background_tint"
                    app:strokeColor="@color/btn_outlined_stroke_color"
                    app:strokeWidth="2dp"
                    app:rippleColor="#20000000"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionB"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:maxLines="5"
                    android:layout_marginBottom="12dp"
                    android:text="選項 B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    app:cornerRadius="12dp"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@color/btn_outlined_background_tint"
                    app:strokeColor="@color/btn_outlined_stroke_color"
                    app:rippleColor="#20000000"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionC"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:maxLines="5"
                    android:layout_marginBottom="12dp"
                    android:text="選項 C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    app:cornerRadius="12dp"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@color/btn_outlined_background_tint"
                    app:strokeColor="@color/btn_outlined_stroke_color"
                    app:rippleColor="#20000000"            />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionD"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:maxLines="5"
                    android:text="選項 D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    app:cornerRadius="12dp"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@color/btn_outlined_background_tint"
                    app:strokeColor="@color/btn_outlined_stroke_color"
                    app:rippleColor="#20000000"            />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_solution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="詳解：" />
            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已完成：" />
            <TextView
                android:id="@+id/tv_correct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正確數：" />
            <TextView
                android:id="@+id/tv_wrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="錯誤數：" />
            <TextView
                android:id="@+id/tv_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="百分率：" />

        </LinearLayout>

        <Button
            android:id="@+id/bt_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="離開" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_facebook_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未登入" />

        </LinearLayout>
    </LinearLayout>


</ScrollView>
