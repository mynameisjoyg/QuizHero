From 1f6799ba594d24793e2504e0cc8e83f126e24161 Mon Sep 17 00:00:00 2001
From: Momo <mynameisjoyg@gmail.com>
Date: Sat, 19 Sep 2026 07:49:47 +0800
Subject: [PATCH] Add android_test.yml to Github Action for testing.

---
 .github/workflows/android_test.yml | 34 ++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 .github/workflows/android_test.yml

diff --git a/.github/workflows/android_test.yml b/.github/workflows/android_test.yml
new file mode 100644
index 0000000..ae75eff
--- /dev/null
+++ b/.github/workflows/android_test.yml
@@ -0,0 +1,34 @@
+name: Android UI Test CI
+
+on:
+  push:
+    branches: [ "main", "master" ]
+  pull_request:
+    branches: [ "main", "master" ]
+
+jobs:
+  instrumented-test:
+    runs-on: macos-13 # 使用 macOS 環境才能開啓硬體加速執行 Android 模擬器
+    timeout-minutes: 30
+
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Setup Gradle
+        uses: gradle/actions/setup-gradle@v3
+
+      - name: Run Android Instrumentation Tests (Espresso)
+        uses: reactivecircus/android-emulator-runner@v2
+        with:
+          api-level: 30
+          target: default
+          arch: x86_64
+          profile: Nexus 6
+          script: ./gradlew connectedCheck
-- 
